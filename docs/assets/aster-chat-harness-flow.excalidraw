{
  "type": "excalidraw",
  "version": 2,
  "source": "Aster verified chat and research harness flow",
  "elements": [
    {"type":"text","id":"title","x":60,"y":36,"width":1650,"height":52,"text":"Aster 채팅 → 연구 하네스 → 프로젝트 파일 → 화면","fontSize":36,"fontFamily":3,"strokeColor":"#1e40af"},
    {"type":"text","id":"subtitle","x":60,"y":96,"width":1650,"height":32,"text":"실제 코드 기준 · 실선 = 앱/CLI의 확정 동작 · 점선 = 에이전트 판단 또는 사용자 선택","fontSize":19,"fontFamily":3,"strokeColor":"#64748b"},
    {"type":"text","id":"chat-lane","x":60,"y":155,"width":1300,"height":35,"text":"A. 일반 채팅: 메시지만으로 Experiment/Run이 자동 생성되지는 않음","fontSize":24,"fontFamily":3,"strokeColor":"#1e40af"},
    {"type":"rectangle","id":"chat-input","x":60,"y":210,"width":290,"height":150,"strokeColor":"#c2410c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"chat-input-text","x":82,"y":231,"width":246,"height":115,"text":"사용자 메시지\n예: ‘LoRA 실험을\n돌려 결과를 비교해줘’","fontSize":20,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"a1","x":355,"y":283,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#c2410c","strokeWidth":3,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"agent-session","x":425,"y":210,"width":325,"height":150,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"agent-session-text","x":447,"y":230,"width":285,"height":120,"text":"기존 Claude / Codex 세션\nWorkbench: Terminal\nWriting·Library: Chat UI\n대화/도구 사용은 세션 소유","fontSize":18,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"a2","x":755,"y":283,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#6d28d9","strokeWidth":3,"strokeStyle":"dashed","endArrowhead":"arrow"},
    {"type":"rectangle","id":"skill-choice","x":825,"y":210,"width":380,"height":150,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"skill-choice-text","x":847,"y":229,"width":340,"height":124,"text":"조건부: 에이전트가 연구 스킬 적용\nstart / track / loop / verify\n스킬 = 절차 안내. 채팅 의도 자동\n분류기는 현재 없음.","fontSize":18,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"a3","x":1210,"y":283,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#b45309","strokeWidth":3,"strokeStyle":"dashed","endArrowhead":"arrow"},
    {"type":"rectangle","id":"harness-cli","x":1280,"y":210,"width":430,"height":150,"strokeColor":"#1e3a5f","backgroundColor":"#93c5fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"harness-cli-text","x":1302,"y":228,"width":390,"height":125,"text":"에이전트가 CLI를 실제 호출\naster research harness-path →\nnode <cli.mjs> preflight / run exec\nloop note / verify / claim add","fontSize":18,"fontFamily":3,"strokeColor":"#1e293b"},
    {"type":"rectangle","id":"no-skill","x":425,"y":385,"width":780,"height":74,"strokeColor":"#dc2626","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"no-skill-text","x":447,"y":394,"width":740,"height":62,"text":"스킬 미사용 / CLI 미호출 → 대화만 남음\n.aster/ 연구 기록은 자동 생성되지 않음","fontSize":18,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"a4","x":900,"y":365,"width":0,"height":18,"points":[[0,0],[0,18]],"strokeColor":"#dc2626","strokeWidth":2,"strokeStyle":"dashed","endArrowhead":"arrow"},
    {"type":"text","id":"ui-lane","x":60,"y":505,"width":1550,"height":36,"text":"B. 명시적 화면 동작: ‘Start research loop’ 버튼은 앱 IPC를 직접 통과","fontSize":24,"fontFamily":3,"strokeColor":"#1e40af"},
    {"type":"rectangle","id":"loop-button","x":60,"y":565,"width":290,"height":175,"strokeColor":"#c2410c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"loop-button-text","x":82,"y":586,"width":250,"height":135,"text":"사용자가 직접 입력\nObjective · metric/방향\nRun/시간/병렬 예산\nCompute policy · Agent","fontSize":18,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"b1","x":355,"y":650,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#c2410c","strokeWidth":3,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"loop-ipc","x":425,"y":565,"width":325,"height":175,"strokeColor":"#1e3a5f","backgroundColor":"#93c5fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"loop-ipc-text","x":447,"y":583,"width":287,"height":145,"text":"researchHarness:loopStart\n로컬 workspace만 지원\nmain에서 경로·입력 검증\n새 Experiment이면 먼저 생성","fontSize":18,"fontFamily":3,"strokeColor":"#1e293b"},
    {"type":"arrow","id":"b2","x":755,"y":650,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#1e3a5f","strokeWidth":3,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"loop-record","x":825,"y":565,"width":380,"height":175,"strokeColor":"#1e3a5f","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"loop-record-text","x":847,"y":582,"width":340,"height":145,"text":"하네스가 기록\nexperiment.json: 질문·metric·\nbudgeted 제안 정책\nloop.jsonl: objective + 예산 +\ncompute policy (실제 GPU 예약 아님)","fontSize":17,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"arrow","id":"b3","x":1210,"y":650,"width":58,"height":0,"points":[[0,0],[58,0]],"strokeColor":"#1e3a5f","strokeWidth":3,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"coordinator","x":1280,"y":565,"width":430,"height":175,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"coordinator-text","x":1302,"y":583,"width":390,"height":145,"text":"백그라운드 조정 에이전트 생성\n스킬 파일·CLI 경로를 프롬프트에 전달\n이후 A 경로의 에이전트 판단·\nCLI 실행으로 이어짐","fontSize":18,"fontFamily":3,"strokeColor":"#374151"},
    {"type":"text","id":"file-lane","x":60,"y":805,"width":1640,"height":36,"text":"C. 두 경로의 기록 위치와 읽기 경로 (새 .aster/ 프로젝트 기준)","fontSize":24,"fontFamily":3,"strokeColor":"#1e40af"},
    {"type":"rectangle","id":"file-tree-box","x":60,"y":865,"width":1020,"height":610,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"file-tree-title","x":85,"y":884,"width":950,"height":32,"text":"사용자 프로젝트/     (원래 code · config · data는 그대로)","fontSize":22,"fontFamily":3,"strokeColor":"#93c5fd"},
    {"type":"text","id":"file-tree","x":85,"y":934,"width":950,"height":490,"text":"├─ paper/main.tex, references.bib    기본 원고 위치; 등록된 기존 경로도 가능\n└─ .aster/                            연구 기록 루트\n   ├─ project.json                   원고/문헌 경로 맵 (Run 목록 아님)\n   ├─ experiments/<slug>/\n   │  ├─ experiment.json             질문·metric·정책\n   │  ├─ loop.jsonl                  objective → 가설 → Run → 결과 → 판단\n   │  ├─ quality.jsonl / proposals.jsonl / ratings.jsonl\n   │  └─ runs/<id>/\n   │     ├─ run.json                 출처·실행 상태/종료 코드\n   │     ├─ code.patch               실행 시 dirty 코드 (있는 경우)\n   │     ├─ metrics.jsonl            ASTER_METRIC 이벤트\n   │     ├─ train.log                stdout/stderr (기본 Git 제외)\n   │     ├─ summary.json             결과 요약\n   │     └─ config.json / media.jsonl / artifacts/  생성 시 존재\n   ├─ claims.json                    원고 주장 ↔ Run 근거\n   ├─ library/papers/                가져온 논문 파일\n   └─ local/                         장치별 상태 (Git 제외)","fontSize":17,"fontFamily":3,"strokeColor":"#a7f3d0","lineHeight":1.35},
    {"type":"arrow","id":"files-to-ui","x":1085,"y":1135,"width":53,"height":0,"points":[[0,0],[53,0]],"strokeColor":"#047857","strokeWidth":3,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"ui-read-box","x":1150,"y":865,"width":560,"height":610,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"ui-read-title","x":1175,"y":889,"width":510,"height":40,"text":"Aster 화면에 반영","fontSize":24,"fontFamily":3,"strokeColor":"#065f46"},
    {"type":"text","id":"ui-read-text","x":1175,"y":941,"width":510,"height":500,"text":"readCatalog는 폴더를 다시 스캔\n↓\n로컬 UI 동기화: 마운트 시 + 10초마다\nExperiment/Run을 ResearchRecords에 연결\n저장: 앱 userData/research/research.json\n↓\nExperiments · Runs · Compare 표시\nWriting/Library는 등록된 경로를 읽음\n\n대화 ↔ Experiment 연결은 별도 UI\n메타데이터: 드래그/메뉴로 명시 연결\n채팅 텍스트로 자동 추론하지 않음\n\n원격 프로젝트의 이 자동 동기화는\n현재 훅에서 지원하지 않음","fontSize":18,"fontFamily":3,"strokeColor":"#374151","lineHeight":1.35},
    {"type":"text","id":"footer","x":60,"y":1505,"width":1640,"height":56,"text":"run exec는 기존 명령을 실행하고 로그·메트릭·상태를 기록한다. GPU 배정/자원 예약은 하지 않는다. 스킬 준수와 연구 결론의 타당성은 자동 보장되지 않는다.","fontSize":18,"fontFamily":3,"strokeColor":"#64748b"}
  ],
  "appState": {"viewBackgroundColor":"#ffffff","gridSize":null},
  "files": {}
}
