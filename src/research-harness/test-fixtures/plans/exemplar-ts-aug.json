{
  "title": "Instance-adaptive augmentation for time-series contrastive learning",
  "method": "A parametric augmentation network learns per-instance views (factorization mask h, transformation mask g, latent masking noise) with a PRI objective and a temporal-consistency loss; an encoder is trained contrastively (global InfoNCE + local subsequence loss), alternating with the augmenter every M steps.",
  "scope": {
    "target": "ICLR full paper",
    "compute": {
      "gpuHours": 450,
      "hardware": "8x A100 40GB",
      "source": "user"
    },
    "outOfScope": [
      {
        "item": "irregularly sampled series",
        "reason": "the method assumes a fixed sampling grid"
      },
      {
        "item": "anomaly detection benchmarks",
        "reason": "no claim about anomaly detection"
      }
    ]
  },
  "claims": [
    {
      "id": "C1",
      "text": "Learned per-instance views beat hand-picked and adaptive augmentations for forecasting and classification",
      "kind": "performance",
      "weight": "main",
      "evidence": ["Q1", "Q2"],
      "status": "planned"
    },
    {
      "id": "C2",
      "text": "The approach is encoder-agnostic and improves several contrastive backbones",
      "kind": "generality",
      "weight": "main",
      "evidence": ["Q3"],
      "status": "planned"
    },
    {
      "id": "C3",
      "text": "Factorization keeps task-relevant information while adding variance",
      "kind": "mechanism",
      "weight": "secondary",
      "evidence": ["Q4"],
      "status": "planned"
    },
    {
      "id": "C4",
      "text": "Good views preserve task information for any downstream task",
      "kind": "analysis",
      "weight": "main",
      "status": "argued-only"
    }
  ],
  "questions": [
    {
      "id": "Q1",
      "claim": "C1",
      "text": "Does our method beat the strongest augmentation-based and adaptive-view baselines on forecasting?",
      "hypothesis": "Lower MSE than the best baseline on at least 5 of 7 forecasting datasets",
      "predictionIfFalse": "No better than the best fixed augmentation tuned with equal trials",
      "minEffect": "2% relative MSE or 0.5 seed std, whichever is larger",
      "experiment": "ts-aug-forecasting"
    },
    {
      "id": "Q2",
      "claim": "C1",
      "text": "Does it beat them on UCR and UEA classification?",
      "hypothesis": "Higher mean accuracy and better mean rank than TS2Vec and InfoTS",
      "predictionIfFalse": "Mean rank no better than TS2Vec",
      "minEffect": "1 point mean accuracy"
    },
    {
      "id": "Q3",
      "claim": "C2",
      "text": "Does it improve two other contrastive frameworks?",
      "hypothesis": "Improves TS-TCC and CoST on 3 of 4 datasets",
      "predictionIfFalse": "Gains only for the TS2Vec backbone",
      "minEffect": "1% relative MSE"
    },
    {
      "id": "Q4",
      "claim": "C3",
      "text": "Do learned masks keep informative steps?",
      "hypothesis": "Masks keep injected signal segments in synthetic data",
      "predictionIfFalse": "Mask overlap with injected segments at chance",
      "minEffect": "IoU 0.2 above random masks"
    }
  ],
